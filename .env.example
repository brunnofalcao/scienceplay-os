# =====================================================================
# Protocolo 5R — EXEMPLO de variáveis de ambiente (SOMENTE NOMES).
#
# Este arquivo documenta os NOMES das variáveis. NÃO coloque valores reais
# aqui e NÃO faça commit de segredos. Os valores reais vão apenas no
# ambiente seguro (Vercel/Supabase/painel de deploy), nunca no repositório.
# Copie para `.env.local` (git-ignored) e preencha localmente se precisar.
# =====================================================================

# --- Banco de dados (Postgres / Supabase) -----------------------------
# Use a string do "Connection Pooling" / Transaction pooler (porta 6543) do
# Supabase para funções serverless. O schema fica em db/schema-5r.sql.
DATABASE_URL=

# --- Supabase (cliente) ----------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- IA de geração (provedor-agnóstico; hoje Anthropic) --------------
# Sem ANTHROPIC_API_KEY, o engine/generate.mjs usa o fallback determinístico.
ANTHROPIC_API_KEY=
# Modelo usado na geração. Default do código: claude-sonnet-5.
AI_MODEL=

# --- Automação / segurança -------------------------------------------
# Protege os endpoints de cron (captura/geração). Ver guardCron() no engine.
CRON_SECRET=
# Opcional: aumenta o limite de chamadas ao PubMed E-utilities.
NCBI_API_KEY=
# E-mail de contato enviado no User-Agent das APIs (polite pool). Opcional.
CONTACT_EMAIL=

# --- Site / SEO -------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# --- Analytics / pixels (públicos) -----------------------------------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Certificação -----------------------------------------------------
# URL oficial de checkout/inscrição. Se vazio, o formulário captura o
# interesse (lead) em vez de redirecionar. Nunca inventar um checkout.
NEXT_PUBLIC_CERT_CHECKOUT_URL=
